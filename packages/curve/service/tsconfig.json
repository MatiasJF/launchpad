{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true
  },
  "include": [
    "*.ts",
    "../src/contracts/ledgerPool.ts"
  ],
  "exclude": [
    "**/* 2.ts",
    "**/* 2.tsx",
    "**/* 2.mjs",
    "**/* 2.json"
  ]
}
