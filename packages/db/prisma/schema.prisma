// BSV Launchpad — data model. See docs/SCHEMA.md for prose + allowed values.
//
// SQLite does NOT support Prisma enums (ADR-011), so enum-like fields are
// `String` with allowed values documented in comments and enforced by the
// `as const` unions in packages/core. Amounts are BigInt (satoshi/token scale).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// An authenticated identity (admin | issuer | public).
model Account {
  id             String    @id @default(cuid())
  identityPubkey String    @unique // BRC-100 identity public key
  paymail        String?
  role           String    @default("public") // admin | issuer | public
  projects       Project[]
  events         Event[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// A team/business launching a token.
model Project {
  id          String   @id @default(cuid())
  ownerId     String
  owner       Account  @relation(fields: [ownerId], references: [id])
  slug        String   @unique
  name        String
  tagline     String?
  description  String?
  logoUrl     String?
  media        String? // JSON array of media URLs
  links        String? // JSON object of links
  team         String? // JSON array of team members
  docs         String? // JSON array of doc links
  payoutAddress String? // BSV address the seller receives sale proceeds at
  status       String   @default("draft") // draft | pending | approved | live | closed
  tokens      Token[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

/// A STAS token issued by a project.
model Token {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  name         String
  ticker       String
  decimals     Int      @default(0)
  totalSupply  BigInt
  allocations  String? // JSON: { public, team, treasury, rewards, airdrop }
  stasTokenId  String?
  issuanceTxid String?
  sales        Sale[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
}

/// An offering of a token's public allocation.
model Sale {
  id                String    @id @default(cuid())
  tokenId           String
  token             Token     @relation(fields: [tokenId], references: [id])
  type              String    @default("instant") // instant | escrow_presale | bonding_curve
  priceSats         BigInt // sats per token
  allocationForSale BigInt
  startsAt          DateTime?
  endsAt            DateTime?
  softCap           BigInt?
  hardCap           BigInt?
  // Escrow presale (ADR-025): fixed pledge denomination in sats. Each pledge is
  // one unit; softCap/hardCap are whole multiples so pledges compose exactly.
  pledgeUnitSats    BigInt?
  status            String    @default("scheduled") // scheduled | live | finalized | failed
  orders            Order[]
  pledges           Pledge[]
  curvePool         CurvePool?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tokenId])
}

/// A bonding-curve AMM reserve pool (Phase 1, ADR-026). ONE on-chain covenant UTXO
/// whose satoshi balance is the reserve and whose script carries `sold`. This row
/// mirrors that UTXO's current state so the operator can sequence buys against the
/// latest outpoint (BSV has no global mutable state). Immutable curve params: `k`
/// (price slope) and `supply` (max sellable). Non-custodial: we store outpoints +
/// scripts, never keys — the covenant is spent by the pushed preimage, not a sig.
model CurvePool {
  id              String   @id @default(cuid())
  saleId          String   @unique
  sale            Sale     @relation(fields: [saleId], references: [id])
  variant         String   @default("linear") // linear (buy-only, ADR-026) | ledger (buy+sell, ADR-027)
  k               BigInt // curve slope: price of the (s+1)-th token = k*(s+1)
  supply          BigInt // max tokens the curve sells
  sold            BigInt   @default(0) // tokens sold so far (== covenant state)
  seedReserveSats BigInt // sats the pool was deployed with (base, below the curve)
  reserveSats     BigInt   @default(0) // current pool UTXO value (== reserve)
  // ledger variant only: JSON [{ownerPkh, amount}] mirroring the covenant's HashedMap
  // so the operator can rebuild the map to prove each spend (the ledger is public).
  ledgerBalances  String?
  // ledger variant: hash160 of the payout address baked into the covenant at deploy;
  // the reserve is released here at graduation (must stay constant for the pool's life).
  payoutPkh       String?
  // stas variant (ADR-028): hash160 of the operator key that gates sells + owns the
  // STAS inventory vault, baked into the reserve covenant at deploy.
  operatorPkh     String?
  poolTxid        String? // current pool outpoint (moves after each buy)
  poolVout        Int?
  // merkle variant (ADR-030): the pool's GENESIS outpoint, which never moves. State is resolved
  // from the chain by walking from here, so unlike the other variants the DB holds no
  // authoritative ledger — only this pointer plus the immutable terms (k, supply, payoutPkh).
  // Kept separate from poolTxid on purpose: that field TRACKS THE TIP for the other variants, and
  // overloading it would make a merkle pool unverifiable the moment the tip advanced.
  genesisTxid     String?
  genesisVout     Int?     @default(0)
  scriptHex       String? // current pool locking script
  status          String   @default("draft") // draft | live | graduated
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// A SIGHASH_ANYONECANPAY assurance-contract pledge for an escrow presale
/// (ADR-025). The contributor signed their OWN exact-value UTXO with 0xC1 over
/// the fixed soft-cap output; funds stay in their wallet until the assurance tx
/// is assembled + broadcast on success. Non-custodial — we only store the
/// signature + outpoint, never keys or funds.
model Pledge {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id])
  contributor    String // BRC-100 identity pubkey of the pledger
  receiveAddress String // where their STAS tokens are delivered on success
  // the pledged UTXO (contributor-owned, exact denomination)
  txid           String
  vout           Int
  satoshis       BigInt
  scriptHex      String // the UTXO's locking script (P2PKH)
  // the 0xC1 pledge signature + pubkey to rebuild the input's unlocking script
  sigHex         String
  pubkeyHex      String
  // derivation of the pledged key (so it can be re-derived if needed)
  derivationPrefix String?
  derivationSuffix String?
  state          String   @default("pledged") // pledged | withdrawn | assembled | expired
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([saleId])
  @@index([contributor])
}

/// A buy (instant) or contribution (escrow) against a sale.
model Order {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
  buyerIdentity  String // BRC-100 pubkey
  receiveAddress String? // buyer's STAS owner address (where tokens are delivered)
  kind           String   @default("instant_buy") // instant_buy | escrow_contribution | curve_buy
  tokens         BigInt
  satsPaid       BigInt
  state          String   @default("pending") // reserved | pending | settling | settled | refunded | withdrawn | failed
  paymentTxid    String? // buyer's sats payment
  txid           String? // settlement (token delivery) tx
  refundTxid     String?
  // curve_sell (ADR-028 step-3): the returned-STAS vout + the full returned outpoint
  // `${returnTxid}:${vout}`. UNIQUE so a single on-chain STAS return can back AT MOST
  // one sell refund — the anti-replay guard (recordStasSell fails P2002 on a dupe).
  returnVout          Int?
  sellReturnOutpoint  String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([saleId])
  @@index([buyerIdentity])
}

/// Append-only audit ledger; payloadHash can be anchored on-chain.
model Event {
  id          String   @id @default(cuid())
  entity      String // e.g. "Sale", "Order"
  entityId    String
  type        String
  actorId     String?
  actor       Account? @relation(fields: [actorId], references: [id])
  payloadHash String? // hash anchored on-chain
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
}
